<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 auto-backup: keep the secure-storage file (ElevenLabs key) out,
     since a Keystore-encrypted value can't be decrypted on another device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
</full-backup-content>
